{
  "name": "obsidian-tabs",
  "version": "1.1.8",
  "description": "Create tabs in your notes.",
  "main": "lib/main.js",
  "license": "MIT",
  "scripts": {
    "build": "obsidian-plugin build --with-stylesheet src/styles.css src/main.ts",
    "dev": "obsidian-plugin dev --vault-path ../TabsTestVault --with-stylesheet src/styles.css src/main.ts",
